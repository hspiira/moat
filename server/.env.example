# Sync server. Copy to .env and fill in. Unlike the web app, these are real
# secrets: none of them reach the browser.
#
# GET /health names whatever is missing, so check it first after deploying.

# Postgres connection string. On Neon use the pooled host, the one with
# "-pooler": tenancy is set per transaction, which is what PgBouncer
# transaction pooling allows.
DATABASE_URL=postgres://user:password@host/database

# Certificates are verified by default. Set "disable" for a local database with
# no TLS, or "no-verify" only for a provider whose certificate the default trust
# store rejects. "no-verify" removes the protection TLS gives against an
# interceptor, so do not reach for it to silence an error.
# DATABASE_SSL=disable

# Connections held open. Keep it small on serverless, where many instances each
# hold a pool.
# DATABASE_POOL_MAX=10

# Required. Endpoints return 503 without it.
#
# This is a single shared token, not per-user authentication: userId is still
# trusted from the request body, so anyone holding this can act as any user.
# Generate with: openssl rand -hex 32
MOAT_SYNC_BEARER_TOKEN=

# Comma-separated origins allowed to call this from a browser. The web app is
# served from a different origin, so without this every sync request fails
# preflight. Origins are matched exactly, never mirrored back.
MOAT_SYNC_ALLOWED_ORIGINS=https://moat.example.com

# Port for local runs. Vercel assigns its own and ignores this.
# PORT=8787

# Tests only: redirects the file-backed development store off the repo.
# Unused in production, which is Postgres.
# MOAT_SYNC_STORE_PATH=
