.next/
.next-test/
node_modules/
tsconfig.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# macOS
.DS_Store

# Static export output
/out/

# Sync server build output. server.js and migrate.js are committed entrypoints
# that import from here; Vercel validates the entrypoint path before building.
server/*.js.map

# Dev-only file-backed sync store
.moat-sync/

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Licensed font files, kept out of git. See app/fonts/README.md.
/app/fonts/helvetica-now-*.woff2
/app/fonts/NeueMachina-*.woff2

# Working copies. Git history is the record.
*.bak

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Per-developer agent harness config. The Claude equivalents under .claude/
# are committed because the whole team shares them; these are whichever tool
# an individual happens to drive the repo with, so they stay on disk and
# readable without standing in every git status.
/.agents/
/.codex/
/opencode.json
