# Web app. Copy to .env.local and fill in. Nothing here is secret: every
# NEXT_PUBLIC_ value is inlined into the JavaScript the browser downloads, so
# never put a token or key in this file.

# Shows the hosted sync controls: endpoint, token, "Sync now", conflicts.
# Off by default and it should stay off until per-user auth exists, because the
# server still trusts userId from the request body. See
# docs/plans/hosted-sync.md.
NEXT_PUBLIC_ENABLE_HOSTED_SYNC=false

# Google OAuth client id for backup to Drive (appdata scope only). Leave unset
# to hide the Drive backup option; file backup and restore work without it.
# A client id is public by design; the client secret is not used here.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Build output directory. Only set by test tooling that needs a build to sit
# somewhere other than .next; leave unset for normal development and deploys.
# NEXT_DIST_DIR=
