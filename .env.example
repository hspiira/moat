# One project, one set of variables. Copy to .env.local for development and set
# the same names in the Vercel project for deploys.
#
# The two groups below differ in kind, not just in purpose. Anything named
# NEXT_PUBLIC_ is inlined into the JavaScript the browser downloads and is
# readable by anyone. Everything under "Sync server" is a real secret and stays
# server side. Never move a value from the second group into the first.

# ---------------------------------------------------------------------------
# Web app. Public, shipped to the browser.
# ---------------------------------------------------------------------------

# Shows the hosted sync controls: endpoint, token, "Sync now", conflicts.
# Off by default and it should stay off until per-user auth exists, because the
# server still trusts userId from the request body. See
# docs/plans/hosted-sync.md.
NEXT_PUBLIC_ENABLE_HOSTED_SYNC=false

# Google OAuth client id for backup to Drive (appdata scope only). Leave unset
# to hide the Drive option; file backup and restore work without it. A client
# id is public by design; no client secret is used.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Build output directory. Test tooling only; leave unset normally.
# NEXT_DIST_DIR=

# ---------------------------------------------------------------------------
# Sync server. Secret, server side only.
# GET /health names whatever is missing, so check it first after deploying.
# ---------------------------------------------------------------------------

# Postgres connection string. On Neon use the pooled host, the one with
# "-pooler": tenancy is set per transaction, which is what PgBouncer
# transaction pooling allows.
DATABASE_URL=postgres://user:password@host/database

# Certificates are verified by default. Set "disable" for a local database with
# no TLS, or "no-verify" only for a provider whose certificate the default trust
# store rejects. "no-verify" removes the protection TLS gives against an
# interceptor, so do not reach for it to silence an error.
# DATABASE_SSL=disable

# Connections held open. Keep it small on serverless, where many instances each
# hold a pool.
# DATABASE_POOL_MAX=10

# Required. Endpoints return 503 without it.
#
# A single shared token, not per-user authentication: userId is still trusted
# from the request body, so anyone holding this can act as any user.
# Generate with: openssl rand -hex 32
MOAT_SYNC_BEARER_TOKEN=

# Only needed when the app is served from a different origin than the sync
# endpoints. With vercel.json routing both through one domain they are
# same-origin, no preflight happens, and this can stay unset.
# MOAT_SYNC_ALLOWED_ORIGINS=https://moat.example.com

# Port for local runs. Vercel assigns its own and ignores this.
# PORT=8787

# Tests only: redirects the file-backed development store off the repo.
# Unused in production, which is Postgres.
# MOAT_SYNC_STORE_PATH=
