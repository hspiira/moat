# Copy to .env.local for development. Set the same names in Vercel for deploys.
# NEXT_PUBLIC_ values are shipped to the browser and readable by anyone.
# Everything under "Sync server" is a secret. Never move one group to the other.

# ---------------------------------------------------------------------------
# Web app. Public.
# ---------------------------------------------------------------------------

# Shows the hosted sync controls. Keep it off until sync payloads are
# encrypted; the server still stores them as plain text.
NEXT_PUBLIC_ENABLE_HOSTED_SYNC=false

# Google OAuth client id for Drive backup. Leave unset to hide the Drive
# option. File backup and restore work without it.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Build output directory. Test tooling only.
# NEXT_DIST_DIR=

# ---------------------------------------------------------------------------
# Sync server. Secret. GET /health names whatever is missing.
# ---------------------------------------------------------------------------

# On Neon use the pooled host, the one with "-pooler".
DATABASE_URL=postgres://user:password@host/database

# "disable" for a local database with no TLS. "no-verify" skips certificate
# checks, so only use it if you know why you need it.
# DATABASE_SSL=disable

# Keep small on serverless, where each instance holds its own pool.
# DATABASE_POOL_MAX=10

# Both are required. The token says who you are; the user id is who you are.
# A request for any other user is refused. One token, one user.
# Make a token with: openssl rand -hex 32
MOAT_SYNC_BEARER_TOKEN=
MOAT_SYNC_BEARER_USER_ID=

# Only needed if the app and the sync server are on different domains.
# MOAT_SYNC_ALLOWED_ORIGINS=https://moat.example.com

# Port for local runs. Vercel ignores this.
# PORT=8787

# Tests only. Production uses Postgres.
# MOAT_SYNC_STORE_PATH=
